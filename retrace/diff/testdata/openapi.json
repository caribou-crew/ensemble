{
  "openapi": "3.0.0",
  "info": { "title": "retrace test fixture", "version": "1.0.0" },
  "paths": {
    "/cart": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Cart" }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "responses": {
          "2XX": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"]
                }
              }
            }
          }
        }
      }
    },
    "/{entity}/{id}": {
      "get": {
        "responses": {
          "500": {
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "type": "object", "required": ["orderId"] }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": { "type": "object", "required": ["orderId"] }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cart": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array" }
        }
      }
    }
  }
